{
  "info": {
    "_postman_id": "warehouse-sprint1-api-v2",
    "name": "WarehouseApp — Sprint 1: Warehouses API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "POST /warehouse/api — создать склад",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"warehouseId\", jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Центральный склад\",\n  \"address\": \"г. Москва, ул. Промышленная, д. 15\",\n  \"type\": \"CENTRAL\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/warehouse/api",
              "host": ["{{baseUrl}}"],
              "path": ["warehouse", "api"]
            }
          }
        },
        {
          "name": "GET /warehouse/api — список всех складов",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/warehouse/api",
              "host": ["{{baseUrl}}"],
              "path": ["warehouse", "api"]
            }
          }
        },
        {
          "name": "GET /warehouse/api/{id} — получить склад по ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/warehouse/api/{{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["warehouse", "api", "{{warehouseId}}"]
            }
          }
        },
        {
          "name": "PATCH /warehouse/api — обновить склад",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has updated name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData.name).to.eql('Центральный склад (обновлён)');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{warehouseId}},\n  \"name\": \"Центральный склад (обновлён)\",\n  \"address\": \"г. Москва, ул. Новая, д. 20\",\n  \"type\": \"REMOTE\",\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/warehouse/api",
              "host": ["{{baseUrl}}"],
              "path": ["warehouse", "api"]
            }
          }
        },
        {
          "name": "DELETE /warehouse/api/{id} — удалить склад",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/warehouse/api/{{warehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["warehouse", "api", "{{warehouseId}}"]
            }
          }
        }
      ]
    },
