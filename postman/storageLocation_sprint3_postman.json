{
  "info": {
    "_postman_id": "storage-location-api-v1",
    "name": "WarehouseApp — Sprint 3: Storage Locations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "POST /storageLocation/api — создать ячейку",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"storageLocationId\", jsonData.id);",
                  "});",
                  "pm.test(\"Response has warehouseName\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('warehouseName');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouseId}},\n  \"zone\": \"A\",\n  \"rack\": \"01\",\n  \"shelf\": \"02\",\n  \"used\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/storageLocation/api",
              "host": ["{{baseUrl}}"],
              "path": ["storageLocation", "api"]
            }
          }
        },
        {
          "name": "GET /storageLocation/api — список всех ячеек (пагинация)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is a page object\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "    pm.expect(jsonData).to.have.property('totalElements');",
                  "    pm.expect(jsonData).to.have.property('totalPages');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/storageLocation/api?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["storageLocation", "api"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET /storageLocation/api — поиск по складу (search)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is a page object\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/storageLocation/api?search=warehouseId:{{warehouseId}},zone:A,",
              "host": ["{{baseUrl}}"],
              "path": ["storageLocation", "api"],
              "query": [
                { "key": "search", "value": "warehouseId:{{warehouseId}},zone:A," }
              ]
            }
          }
        },
        {
          "name": "GET /storageLocation/api/{id} — получить ячейку по ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has zone\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('zone');",
                  "});",
                  "pm.test(\"Response has warehouseName\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('warehouseName');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/storageLocation/api/{{storageLocationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["storageLocation", "api", "{{storageLocationId}}"]
            }
          }
        },
        {
          "name": "PATCH /storageLocation/api — обновить ячейку",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has updated rack\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('rack');",
                  "    pm.expect(jsonData.rack).to.eql('05');",
                  "});",
                  "pm.test(\"Response has updated used\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.used).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{storageLocationId}},\n  \"warehouseId\": {{warehouseId}},\n  \"zone\": \"A\",\n  \"rack\": \"05\",\n  \"shelf\": \"03\",\n  \"used\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/storageLocation/api",
              "host": ["{{baseUrl}}"],
              "path": ["storageLocation", "api"]
            }
          }
        },
        {
          "name": "DELETE /storageLocation/api/{id} — удалить ячейку",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/storageLocation/api/{{storageLocationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["storageLocation", "api", "{{storageLocationId}}"]
            }
          }
        }
      ]
    },
