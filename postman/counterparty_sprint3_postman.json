{
  "info": {
    "_postman_id": "counterparty-sprint3-api-v2",
    "name": "WarehouseApp — Sprint 3: Counterparty API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "POST /counterparty/api — создать контрагента",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"counterpartyId\", jsonData.id);",
                  "});",
                  "pm.test(\"Response has name and inn\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('inn');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ООО «Поставщик №1»\",\n  \"inn\": \"7701234567\",\n  \"kpp\": \"770101001\",\n  \"counterpartyType\": \"SUPPLIER\",\n  \"phone\": \"+79991234567\",\n  \"contact\": \"Иванов И.И.\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/counterparty/api",
              "host": ["{{baseUrl}}"],
              "path": ["counterparty", "api"]
            }
          }
        },
        {
          "name": "GET /counterparty/api/{id} — получить контрагента по ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
