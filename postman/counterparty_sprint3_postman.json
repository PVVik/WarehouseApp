                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/counterparty/api/{{counterpartyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["counterparty", "api", "{{counterpartyId}}"]
            }
          }
        },
        {
          "name": "PATCH /counterparty/api — обновить контрагента",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has updated contact\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.contact).to.eql(\"Петров П.П.\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{counterpartyId}},\n  \"name\": \"ООО «Поставщик №1 (обновлён)»\",\n  \"inn\": \"7701234567\",\n  \"kpp\": \"770101001\",\n  \"counterpartyType\": \"SUPPLIER\",\n  \"phone\": \"+79991234567\",\n  \"contact\": \"Петров П.П.\",\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/counterparty/api",
              "host": ["{{baseUrl}}"],
              "path": ["counterparty", "api"]
            }
          }
        },
        {
          "name": "GET /counterparty/api — список всех контрагентов (с пагинацией)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is a page object\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData).to.have.property('totalElements');",
                  "    pm.expect(jsonData).to.have.property('totalPages');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/counterparty/api?page=0&size=10&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["counterparty", "api"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "id,asc" }
              ]
            }
          }
        },
        {
          "name": "GET /counterparty/api — поиск по параметру search",
          "event": [
            {
              "listen": "test",
              "script": {
