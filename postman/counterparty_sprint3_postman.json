                  "});",
                  "pm.test(\"Response contains search results\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/counterparty/api?search=name:Поставщик&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["counterparty", "api"],
              "query": [
                { "key": "search", "value": "name:Поставщик" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
