        {
          "name": "POST /counterparty/api — 409 (дубликат ИНН)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/counterparty/api\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            name: \"ООО «Оригинал для дубликата»\",",
                  "            inn: \"7701234567\",",
                  "            kpp: \"770101001\",",
                  "            counterpartyType: \"SUPPLIER\",",
                  "            phone: \"+79991234567\",",
                  "            contact: \"Оригиналов О.О.\",",
                  "            isActive: true",
                  "        })",
                  "    }",
                  "}, function (err, response) {",
                  "    if (response.code === 201) {",
                  "        console.log(\"Подготовка: контрагент для дубликата создан\");",
                  "    } else if (response.code === 409) {",
                  "        console.log(\"Контрагент с таким ИНН уже существует — отлично\");",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Response mentions duplicate INN\", function () {",
                  "    var body = pm.response.text();",
                  "    pm.expect(body).to.contain(\"ИНН\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ООО «Дубликат»\",\n  \"inn\": \"7701234567\",\n  \"kpp\": \"770101001\",\n  \"counterpartyType\": \"CUSTOMER\",\n  \"phone\": \"+79990000000\",\n  \"contact\": \"Дубликатов Д.Д.\",\n  \"isActive\": true\n}"
            },
            "url": {
