        {
          "name": "GET /nomenclature/api?sort=stuffCategory,desc&sort=name,asc — составная сортировка",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content is sorted by category desc then name asc\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var content = jsonData.content;",
                  "    if (content.length > 1) {",
                  "        for (var i = 1; i < content.length; i++) {",
                  "            var catCompare = content[i].stuffCategory.localeCompare(content[i-1].stuffCategory);",
                  "            if (catCompare === 0) {",
                  "                pm.expect(content[i].name >= content[i-1].name,",
                  "                    'within same category names should be ascending').to.be.true;",
                  "            } else {",
                  "                pm.expect(catCompare <= 0,",
                  "                    'categories should be descending').to.be.true;",
                  "            }",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            }
          ],
