  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "POST /nomenclature/api — создать позицию",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"nomenclatureId\", jsonData.id);",
                  "});",
                  "pm.test(\"Response has sku\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('sku');",
                  "    pm.collectionVariables.set(\"nomenclatureSku\", jsonData.sku);",
                  "});",
                  "pm.test(\"Response has name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData.name).to.eql('Болт М8 оцинкованный');",
                  "});",
                  "pm.test(\"Response has stuffCategory\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('stuffCategory');",
                  "    pm.expect(jsonData.stuffCategory).to.eql('MATERIAL');",
                  "});",
                  "pm.test(\"Response has unitOfMeasure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('unitOfMeasure');",
                  "    pm.expect(jsonData.unitOfMeasure).to.eql('PIECE');",
                  "});",
                  "pm.test(\"Response has inventoryType\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('inventoryType');",
                  "    pm.expect(jsonData.inventoryType).to.eql('QUANTITY');",
                  "});",
                  "pm.test(\"Response has active\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('active');",
                  "    pm.expect(jsonData.active).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
