          "name": "GET /nomenclature/api?sort=name,asc — сортировка по имени",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content is sorted by name ascending\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var content = jsonData.content;",
                  "    if (content.length > 1) {",
                  "        for (var i = 1; i < content.length; i++) {",
                  "            pm.expect(content[i].name >= content[i-1].name,",
                  "                'names should be in ascending order').to.be.true;",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            }
