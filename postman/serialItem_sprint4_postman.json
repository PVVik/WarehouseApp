                  "pm.test(\"Search result contains our item\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var found = jsonData.content.some(function (s) {",
                  "        return Number(s.id) === Number(pm.collectionVariables.get('serialItemId'));",
                  "    });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
