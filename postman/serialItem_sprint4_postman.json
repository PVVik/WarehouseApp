        {
          "name": "GET /serial-item/api — поиск по серийному номеру",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Search by serialNumber finds our item\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var found = jsonData.content.some(function (s) {",
                  "        return s.serialNumber === 'SN20240001';",
                  "    });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/serial-item/api?search=serialNumber:SN20240001&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "serial-item",
                "api"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "serialNumber:SN20240001"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /serial-item/api — обновить статус серийной единицы",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Updated status is IN_USE\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('IN_USE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{serialItemId}},\n  \"status\": \"IN_USE\",\n  \"notes\": \"Передана в эксплуатацию\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/serial-item/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "serial-item",
                "api"
              ]
            }
          }
        },
