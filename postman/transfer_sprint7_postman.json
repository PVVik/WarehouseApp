  "item": [
    {
      "name": "Setup (подготовка контента)",
      "description": "Создаёт поставщика, номенклатуру, 2 склада, ячейку, делает приход. Запускать первым.",
      "item": [
        {
          "name": "POST /counterparty/api — создать поставщика",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"counterpartyIdTransfer\", jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ООО Поставщик Труб\",\n  \"inn\": \"7701234567\",\n  \"kpp\": \"770101001\",\n  \"counterpartyType\": \"SUPPLIER\",\n  \"phone\": \"+73466123456\",\n  \"contact\": \"Иванов Иван\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/counterparty/api"
          }
        },
        {
          "name": "POST /nomenclature/api — номенклатура (QUANTITY)",
          "event": [
            {
              "listen": "test",
              "script": {
