        {
          "name": "POST /receipt/api — приход (оприходование на склад-отправитель)",
          "description": "Важно: приход на warehouseFrom, иначе будет ошибка проверки остатков.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id and number\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('number');",
                  "    pm.collectionVariables.set(\"receiptIdTransfer\", jsonData.id);",
                  "    pm.collectionVariables.set(\"receiptNumberTransfer\", jsonData.number);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movementType\": \"RECEIPT\",\n  \"nomenclatureId\": {{nomenclatureIdTransfer}},\n  \"warehouseTo\": {{warehouseFromIdTransfer}},\n  \"counterpartyId\": {{counterpartyIdTransfer}},\n  \"quantity\": 10,\n  \"price\": 500,\n  \"number\": \"DOC-REC-002\",\n  \"date\": \"2026-01-01\",\n  \"userId\": 1,\n  \"notes\": \"Приход для теста трансфера\",\n  \"storageLocationId\": {{storageLocationIdTransfer}}\n}"
            },
            "url": "{{baseUrl}}/receipt/api"
          }
        }
