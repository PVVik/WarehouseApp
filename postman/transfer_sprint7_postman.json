{
  "info": {
    "_postman_id": "warehouse-sprint7-transfer-api",
    "name": "WarehouseApp — Sprint 7: Transfer (Трансфер) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
