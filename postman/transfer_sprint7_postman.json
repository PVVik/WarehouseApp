    {
      "name": "Success (успешный трансфер)",
      "item": [
        {
          "name": "POST /transfer/api — успешный трансфер (QUANTITY)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has id and number\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('number');",
                  "    pm.collectionVariables.set(\"transferId\", jsonData.id);",
                  "    pm.collectionVariables.set(\"transferNumber\", jsonData.number);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movementType\": \"TRANSFER\",\n  \"nomenclatureId\": {{nomenclatureIdTransfer}},\n  \"batchId\": null,\n  \"serialItemId\": null,\n  \"warehouseFrom\": {{warehouseFromIdTransfer}},\n  \"warehouseTo\": {{warehouseToIdTransfer}},\n  \"storageLocationId\": {{storageLocationIdTransfer}},\n  \"quantity\": 3,\n  \"userId\": 1,\n  \"notes\": \"Трансфер по акту №321\"\n}"
            },
            "url": "{{baseUrl}}/transfer/api"
          }
        }
      ]
