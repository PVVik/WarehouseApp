            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Труба стальная 108x4 (для трансфера)\",\n  \"sku\": \"TRB-TF-108-4\",\n  \"stuffCategory\": \"MATERIAL\",\n  \"unitOfMeasure\": \"METER\",\n  \"inventoryType\": \"QUANTITY\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/nomenclature/api"
          }
        },
